{
  "StorageSense": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\StorageSense",
        "name": "AllowStorageSenseGlobal",
        "kind": "DWord",
        "value": 0,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regRemove",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\StorageSense",
        "name": "AllowStorageSenseGlobal"
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\StorageSense",
        "name": "AllowStorageSenseGlobal",
        "kind": "DWord",
        "expected": 0
      }
    ]
  },
  "Tips": {
