      },
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SubscribedContent-338388Enabled",
        "kind": "DWord",
        "value": 0,
        "createKeyIfMissing": true
      },
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SubscribedContent-338389Enabled",
        "kind": "DWord",
        "value": 0,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SoftLandingEnabled",
        "kind": "DWord",
        "value": 1,
        "createKeyIfMissing": true
      },
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SubscribedContent-338388Enabled",
        "kind": "DWord",
        "value": 1,
        "createKeyIfMissing": true
      },
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SubscribedContent-338389Enabled",
        "kind": "DWord",
        "value": 1,
        "createKeyIfMissing": true
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
        "name": "SoftLandingEnabled",
        "kind": "DWord",
        "expected": 0
      }
    ]
  },
  "ConsumerFeatures": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent",
        "name": "DisableWindowsConsumerFeatures",
        "kind": "DWord",
        "value": 1,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regRemove",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent",
        "name": "DisableWindowsConsumerFeatures"
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent",
        "name": "DisableWindowsConsumerFeatures",
        "kind": "DWord",
        "expected": 1
      }
    ]
  },
  "ScheduledDefrag": {
    "apply": [
      {
        "type": "commandRun",
        "fileName": "schtasks.exe",
        "arguments": "/Change /TN \"\\Microsoft\\Windows\\Defrag\\ScheduledDefrag\" /Disable"
      }
    ],
    "unapply": [
      {
        "type": "commandRun",
        "fileName": "schtasks.exe",
        "arguments": "/Change /TN \"\\Microsoft\\Windows\\Defrag\\ScheduledDefrag\" /Enable"
      }
    ],
    "state": [
      {
        "type": "commandGet",
        "fileName": "schtasks.exe",
        "arguments": "/Query /TN \"\\Microsoft\\Windows\\Defrag\\ScheduledDefrag\" /FO LIST",
        "outputContains": "Disabled"
      }
    ]
  },
  "DeliveryOptimization": {
    "apply": [
      {
        "type": "serviceSet",
        "serviceName": "DoSvc",
        "startupType": "Disabled",
        "stopFirst": true
      }
    ],
    "unapply": [
      {
        "type": "serviceSet",
        "serviceName": "DoSvc",
        "startupType": "Automatic"
      }
    ],
    "state": [
      {
        "type": "serviceGet",
        "serviceName": "DoSvc",
        "expectedStartupType": "Disabled"
      }
    ]
  },
  "OneDriveAutoStart": {
    "apply": [
      {
        "type": "regRemoveWithBackup",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Run",
        "name": "OneDrive"
      }
    ],
    "unapply": [
      {
        "type": "regRestoreFromBackup",
        "backupKey": "onedrive_autostart"
      }
    ],
    "state": [
      {
        "type": "regNotExists",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Run",
        "name": "OneDrive"
      }
    ]
  },
  "EdgePreload": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\MicrosoftEdge\\Main",
        "name": "AllowPrelaunch",
        "kind": "DWord",
        "value": 0,
        "createKeyIfMissing": true
      },
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\MicrosoftEdge\\Main",
        "name": "AllowTabPreloading",
        "kind": "DWord",
        "value": 0,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regRemove",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\MicrosoftEdge\\Main",
        "name": "AllowPrelaunch"
      },
      {
        "type": "regRemove",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\MicrosoftEdge\\Main",
        "name": "AllowTabPreloading"
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\MicrosoftEdge\\Main",
        "name": "AllowPrelaunch",
        "kind": "DWord",
        "expected": 0
      }
    ]
  },
  "WindowsUpdatePause": {
    "apply": [
      {
        "type": "regSetDynamicDate",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings",
        "name": "PauseUpdatesExpiryTime",
        "daysFromNow": 35,
        "format": "yyyy-MM-ddTHH:mm:ssZ",
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regRemove",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings",
        "name": "PauseUpdatesExpiryTime"
      }
    ],
    "state": [
      {
        "type": "regGetDateInFuture",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings",
        "name": "PauseUpdatesExpiryTime"
      }
    ]
  }
}