  "DefenderScanLimit": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows Defender\\Scan",
        "name": "ScanAvgCPULoadFactor",
        "kind": "DWord",
        "value": 20,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows Defender\\Scan",
        "name": "ScanAvgCPULoadFactor",
        "kind": "DWord",
        "value": 50,
        "createKeyIfMissing": true
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows Defender\\Scan",
        "name": "ScanAvgCPULoadFactor",
        "kind": "DWord",
        "lessOrEqualInt": 20
      }
    ]
  },
  "WerSvc": {
    "apply": [
      {
        "type": "serviceSet",
        "serviceName": "WerSvc",
        "startupType": "Disabled",
        "stopFirst": true
      }
    ],
    "unapply": [
      {
        "type": "serviceSet",
        "serviceName": "WerSvc",
        "startupType": "Manual"
      }
    ],
    "state": [
      {
        "type": "serviceGet",
        "serviceName": "WerSvc",
        "expectedStartupType": "Disabled"
      }
    ]
  },
  "FastStartup": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
        "name": "HiberbootEnabled",
        "kind": "DWord",
        "value": 0
      }
    ],
    "unapply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
        "name": "HiberbootEnabled",
        "kind": "DWord",
        "value": 1
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
        "name": "HiberbootEnabled",
        "kind": "DWord",
        "expected": 0
      }
    ]
  },
  "ReservedStorage": {
    "apply": [
      {
        "type": "commandRun",
        "fileName": "DISM.exe",
        "arguments": "/Online /Set-ReservedStorageState /State:Disabled"
      }
    ],
    "unapply": [
      {
        "type": "commandRun",
        "fileName": "DISM.exe",
        "arguments": "/Online /Set-ReservedStorageState /State:Enabled"
      }
    ],
    "state": [
      {
        "type": "commandGet",
        "fileName": "DISM.exe",
        "arguments": "/Online /Get-ReservedStorageState",
        "outputContains": "Disabled"
      }
    ]
  },
  "EventLogSize": {
    "apply": [
      {
        "type": "commandRun",
        "fileName": "wevtutil.exe",
        "arguments": "sl Application /ms:10240"
      },
      {
        "type": "commandRun",
        "fileName": "wevtutil.exe",
        "arguments": "sl System /ms:10240"
      }
    ],
    "unapply": [
      {
        "type": "commandRun",
        "fileName": "wevtutil.exe",
        "arguments": "sl Application /ms:20480"
      },
      {
        "type": "commandRun",
        "fileName": "wevtutil.exe",
        "arguments": "sl System /ms:20480"
      }
    ],
    "state": [
      {
        "type": "commandGet",
        "fileName": "wevtutil.exe",
        "arguments": "gl Application /f:xml",
        "outputContains": "<maxSize>10240</maxSize>"
      }
    ]
  },
  "SearchIndexing": {
    "apply": [
      {
        "type": "serviceSet",
