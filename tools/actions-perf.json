{
  "Transparency": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
        "name": "EnableTransparency",
        "kind": "DWord",
        "value": 0,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
        "name": "EnableTransparency",
        "kind": "DWord",
        "value": 1,
        "createKeyIfMissing": true
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
        "name": "EnableTransparency",
        "kind": "DWord",
        "expected": 0
      }
    ]
  },
  "StartupDelay": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize",
        "name": "StartupDelayInMSec",
        "kind": "DWord",
        "value": 0,
        "createKeyIfMissing": true
      },
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize",
        "name": "WaitForIdleState",
        "kind": "DWord",
        "value": 0,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regRemove",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize",
        "name": "StartupDelayInMSec"
      },
      {
        "type": "regRemove",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize",
        "name": "WaitForIdleState"
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize",
        "name": "StartupDelayInMSec",
        "kind": "DWord",
        "expected": 0
      }
    ]
  },
  "MenuDelay": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Control Panel\\Desktop",
        "name": "MenuShowDelay",
        "kind": "String",
        "value": "0",
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Control Panel\\Desktop",
        "name": "MenuShowDelay",
        "kind": "String",
        "value": "400",
        "createKeyIfMissing": true
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKCU",
        "key": "Control Panel\\Desktop",
        "name": "MenuShowDelay",
        "kind": "String",
        "lessOrEqualInt": 50
      }
    ]
  },
  "BackgroundApps": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\BackgroundAccessApplications",
        "name": "GlobalUserDisabled",
        "kind": "DWord",
        "value": 1,
        "createKeyIfMissing": true
      },
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "Software\\Policies\\Microsoft\\Windows\\AppPrivacy",
        "name": "LetAppsRunInBackground",
        "kind": "DWord",
        "value": 2,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regRemove",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\BackgroundAccessApplications",
        "name": "GlobalUserDisabled"
      },
      {
        "type": "regRemove",
        "hive": "HKLM",
        "key": "Software\\Policies\\Microsoft\\Windows\\AppPrivacy",
        "name": "LetAppsRunInBackground"
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\BackgroundAccessApplications",
        "name": "GlobalUserDisabled",
        "kind": "DWord",
        "expected": 1
      }
    ]
  },
  "Prefetch": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
