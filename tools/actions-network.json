{
  "NetworkThrottle": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
        "name": "NetworkThrottlingIndex",
        "kind": "DWord",
        "value": -1
      }
    ],
    "unapply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
        "name": "NetworkThrottlingIndex",
        "kind": "DWord",
        "value": 10
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
        "name": "NetworkThrottlingIndex",
        "kind": "DWord",
        "expected": -1
      }
    ]
  },
  "TcpAutotuning": {
    "apply": [
      {
        "type": "commandRun",
        "fileName": "netsh.exe",
        "arguments": "int tcp set global autotuninglevel=disabled"
      }
    ],
    "unapply": [
      {
        "type": "commandRun",
        "fileName": "netsh.exe",
        "arguments": "int tcp set global autotuninglevel=normal"
      }
    ],
    "state": [
      {
        "type": "commandGet",
        "fileName": "netsh.exe",
        "arguments": "int tcp show global",
        "outputContains": "disabled"
      }
    ]
  },
  "Nagle": {
    "apply": [
      {
        "type": "regSetAllSubKeys",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces",
        "name": "TcpAckFrequency",
        "kind": "DWord",
        "value": 1
      },
      {
        "type": "regSetAllSubKeys",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces",
        "name": "TCPNoDelay",
        "kind": "DWord",
        "value": 1
      }
    ],
    "unapply": [
      {
        "type": "regRemoveAllSubKeys",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces",
        "name": "TcpAckFrequency"
      },
      {
        "type": "regRemoveAllSubKeys",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces",
        "name": "TCPNoDelay"
      }
    ],
    "state": [
      {
        "type": "regGetAllSubKeys",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces",
        "name": "TcpAckFrequency",
        "kind": "DWord",
        "expected": 1
      }
    ]
  },
  "QosReserved": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\Psched",
        "name": "NonBestEffortLimit",
        "kind": "DWord",
        "value": 0,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\Psched",
        "name": "NonBestEffortLimit",
        "kind": "DWord",
        "value": 20,
        "createKeyIfMissing": true
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\Psched",
        "name": "NonBestEffortLimit",
        "kind": "DWord",
        "expected": 0
      }
    ]
  },
  "NetBIOS": {
    "apply": [
      {
        "type": "regSetAllSubKeys",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters\\Interfaces",
        "name": "NetbiosOptions",
        "kind": "DWord",
        "value": 2
      }
    ],
    "unapply": [
      {
        "type": "regRemoveAllSubKeys",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters\\Interfaces",
        "name": "NetbiosOptions"
      }
    ],
    "state": [
      {
        "type": "regGetAllSubKeys",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters\\Interfaces",
        "name": "NetbiosOptions",
        "kind": "DWord",
        "expected": 2
      }
    ]
  },
  "IPv6": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\Tcpip6\\Parameters",
        "name": "DisabledComponents",
        "kind": "DWord",
        "value": 255,
        "createKeyIfMissing": true
      }
    ],
    "unapply": [
      {
        "type": "regRemove",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\Tcpip6\\Parameters",
        "name": "DisabledComponents"
      }
    ],
    "state": [
      {
        "type": "regGet",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\Tcpip6\\Parameters",
        "name": "DisabledComponents",
        "kind": "DWord",
        "expected": 255
      }
    ]
  },
  "WindowsUpdateP2P": {
    "apply": [
      {
        "type": "regSet",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\DeliveryOptimization\\Config",
