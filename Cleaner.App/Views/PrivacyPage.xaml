<Page x:Class="Cleaner.App.Views.PrivacyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:PrivacyViewModel}"
      Title="Приватность"
      Foreground="#FFFFFF"
      Background="#0E0E10">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Border Height="220" VerticalAlignment="Top" Background="{StaticResource PageHeaderBrush}"/>

        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="52" Height="52"
                        CornerRadius="14"
                        Background="{StaticResource AccentGradientBrush}"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="LockClosed24"
                                   FontSize="26"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Приватность"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="Белый список и карантин удалённых файлов"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CategoryCardStyle}"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24"
                                           FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                            <TextBlock Text="Белый список"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WhitelistRules.Count, StringFormat=' • {0}'}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding WhitelistPath}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,6,0,10"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding WhitelistPath}"/>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      MinHeight="180">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="2,8,0,0"
                                           Text="Правил пока нет. Добавьте первое правило ниже — файлы, подходящие под него, не будут удаляться.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWhitelistRules}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding WhitelistRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RowBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ui:SymbolIcon Grid.Column="0"
                                                                   Symbol="ShieldCheckmark24"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding}"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               Foreground="#FFFFFF"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <ui:Button Grid.Column="2"
                                                               Padding="6,2"
                                                               Icon="{ui:SymbolIcon Delete24}"
                                                               ToolTip="Удалить правило"
                                                               Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        PlaceholderText="Пример: *.log, re:\.bak$, C:\Keep\file.txt"
                                        Text="{Binding NewRuleText, UpdateSourceTrigger=PropertyChanged}"/>

                            <ui:Button Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Padding="16,8"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Appearance="Primary"
                                       Content="Добавить"
                                       Command="{Binding AddRuleCommand}"/>

                            <ui:Button Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Padding="16,8"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Content="Очистить"
                                       ToolTip="Удалить все правила"
                                       Command="{Binding ClearRulesCommand}"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CategoryCardStyle}"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24"
                                           FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                            <TextBlock Text="Карантин"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,6,0,10">
                            <TextBlock Text="{Binding QuarantineSummary}"
                                       FontSize="12"
                                       Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding QuarantinePath}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding QuarantinePath}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      MinHeight="180">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="2,8,0,0"
                                           Text="Карантин пуст. Сюда попадают файлы, удалённые через «Очистку», — их можно восстановить в течение 24 часов.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasQuarantineSessions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding QuarantineSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RowBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CreatedText}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"/>
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Margin="0,2,0,0">
                                                            <Run Text="{Binding Count, Mode=OneWay, StringFormat='{}{0} объектов'}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <ui:Button Grid.Column="1"
                                                               Padding="6,2"
                                                               Icon="{ui:SymbolIcon ArrowUndo24}"
                                                               ToolTip="Восстановить файлы"
                                                               Command="{Binding DataContext.RestoreSessionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}"/>

                                                    <ui:Button Grid.Column="2"
                                                               Padding="6,2"
                                                               Margin="4,0,0,0"
                                                               Icon="{ui:SymbolIcon Delete24}"
                                                               ToolTip="Удалить сессию безвозвратно"
                                                               Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ui:Button Grid.Row="3"
                                   Margin="0,10,0,0"
                                   Padding="16,8"
                                   HorizontalAlignment="Left"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Content="Очистить старые (7+ дней)"
                                   ToolTip="Удалить сессии старше 7 дней"
                                   Command="{Binding CleanOldCommand}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,16,0,0"
                    Padding="16,12"
                    CornerRadius="12"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <ui:Button Grid.Column="1"
                               Padding="20,12"
                               FontSize="14"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Content="Обновить"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Перечитать правила и карантин"/>
                </Grid>
            </Border>

            <ui:ProgressRing Grid.Row="2"
                             Width="32" Height="32"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,4,12,0"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Page>