<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" x:Class="Cleaner.App.Views.WhatsNewPage" Background="{DynamicResource BgBaseBrush}" Title="{loc:Loc news.title}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc news.title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{loc:Loc news.subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource BgOverlayBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Top">
                <TextBlock Text="{Binding CurrentVersion}" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0" />
            </Border>
        </Grid>
        <ui:InfoBar Grid.Row="1" Title="{loc:Loc news.load.failed}" Message="{Binding ErrorText}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Severity="Warning" />
        <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="2" Padding="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="164" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Border Width="1" Background="{DynamicResource BorderStrongBrush}" HorizontalAlignment="Center" Margin="0,-12,0,-12" />
                            <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                            <TextBlock Text="{Binding Version}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                            <TextBlock Text="{loc:Loc news.current}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,5,0,0" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Expander Grid.Column="2" Style="{StaticResource CompactExpanderStyle}" IsExpanded="{Binding IsCurrent, Mode=OneWay}" AutomationProperties.Name="{Binding Version}">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="18,10,12,0">
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ReleaseRow" Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,12">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ReleaseRow" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="ReleaseRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="ReleaseRow" Property="BorderThickness" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</Page>