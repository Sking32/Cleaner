<UserControl x:Class="Cleaner.App.Views.FirstRunSafetyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" KeyboardNavigation.TabNavigation="Cycle" Foreground="{StaticResource TextPrimaryBrush}">
    <Border MaxWidth="680" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Stretch" Padding="24" Background="{StaticResource BgOverlayBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource AccentBrush}" FontSize="26" Margin="0,0,12,0"/>
                    <TextBlock Text="{loc:Loc safety.title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc safety.intro}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{loc:Loc safety.preview}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="{loc:Loc safety.files}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="{loc:Loc safety.system}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource CategoryCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc safety.restore.title}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{loc:Loc safety.restore.explain}" TextWrapping="Wrap" Margin="0,8,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{loc:Loc safety.restore.limits}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="CreatePointButton" Content="{loc:Loc safety.create}" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding CreateRestorePointCommand}" Appearance="Primary" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,10"/>
                    <ui:Button x:Name="ContinueButton" Content="{loc:Loc safety.continue}" Command="{Binding ContinueCommand}" Padding="14,10" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock Text="{loc:Loc safety.reopen}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
