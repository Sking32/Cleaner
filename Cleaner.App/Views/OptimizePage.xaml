<Page x:Class="Cleaner.App.Views.OptimizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:OptimizeViewModel}"
      Title="Оптимизация"
      Foreground="#FFFFFF"
      Background="#0E0E10">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Border Height="220" VerticalAlignment="Top" Background="{StaticResource PageHeaderBrush}"/>

        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="52" Height="52"
                        CornerRadius="14"
                        Background="{StaticResource AccentGradientBrush}"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Rocket24"
                                   FontSize="26"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Оптимизация"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="62 твика по категориям. Переключатель применяет или снимает твик"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Пресет"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8"/>
                    <ListBox ItemsSource="{Binding Presets}"
                             SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="PresetChipStyle"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Bottom"
                           Padding="14,8"
                           FontSize="12"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Content="Сбросить выбор"
                           Command="{Binding ClearPresetCommand}"
                           IsEnabled="{Binding HasSelectedPreset}"
                           ToolTip="Снять выделение пресета"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Border Padding="12,8" CornerRadius="8"
                        Background="#2060CDFF"
                        BorderBrush="#4060CDFF"
                        BorderThickness="1"
                        Visibility="{Binding HasPresetNote, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PresetNoteText}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="#FFFFFF"/>
                </Border>

                <Border Margin="0,6,0,0" Padding="12,8" CornerRadius="8"
                        Background="#208D6E00"
                        BorderBrush="#408D6E00"
                        BorderThickness="1"
                        Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ConflictText}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="#F5C842"/>
                </Border>

                
            </StackPanel>

            <ScrollViewer Grid.Row="3" Margin="0,14,0,0"
                          MinHeight="200"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CategoryCardStyle}" Margin="0,0,0,10">
                                <ui:CardExpander IsExpanded="True">
                                    <ui:CardExpander.Icon>
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="16"/>
                                    </ui:CardExpander.Icon>
                                    <ui:CardExpander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CountText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </ui:CardExpander.Header>

                                    <ItemsControl ItemsSource="{Binding Tweaks}" Margin="4,2,4,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowBorderStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Width="22" Height="22"
                                                                CornerRadius="11"
                                                                VerticalAlignment="Top"
                                                                Margin="0,3,10,0"
                                                                ToolTip="{Binding LevelLabel}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#3A3A3A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}" Value="safe">
                                                                            <Setter Property="Background" Value="#1B5E20"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="caution">
                                                                            <Setter Property="Background" Value="#8D6E00"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="danger">
                                                                            <Setter Property="Background" Value="#8B1A1A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding LevelShort}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,12,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13"
                                                                           Foreground="#FFFFFF"
                                                                           TextWrapping="Wrap"/>
                                                                <Border Background="{StaticResource CautionBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="6,1"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="Твик требует перезагрузки"
                                                                        Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="REBOOT"
                                                                               FontSize="9"
                                                                               FontWeight="Bold"
                                                                               Foreground="White"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="640"
                                                                       Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding Warn}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource CautionBrush}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="640"
                                                                       Margin="0,3,0,0"
                                                                       Visibility="{Binding HasWarn, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>

                                                        <ui:ToggleSwitch Grid.Column="2"
                                                                         VerticalAlignment="Center"
                                                                         IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                                                         IsEnabled="{Binding CanToggle}"
                                                                         OnContent=""
                                                                         OffContent=""/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ui:CardExpander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="4"
                    Margin="0,16,0,0"
                    Padding="16,12"
                    CornerRadius="12"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap"
                                   MaxWidth="440"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding PendingRebootText}"
                                   Foreground="{StaticResource CautionBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasPendingReboot, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Margin="8,0"
                               Padding="20,12"
                               FontSize="14"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Play24}"
                               Content="Применить пресет"
                               Command="{Binding ApplyPresetCommand}"
                               ToolTip="Применить все твики выбранного пресета"/>

                    <ui:Button Grid.Column="2"
                               Margin="8,0"
                               Padding="20,12"
                               FontSize="14"
                               Icon="{ui:SymbolIcon ArrowUndo24}"
                               Content="Откатить всё"
                               Command="{Binding RollbackAllCommand}"
                               ToolTip="Восстановить все значения из бэкапа"/>

                    <ui:Button Grid.Column="3"
                               Padding="20,12"
                               FontSize="14"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Content="Обновить"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Перечитать состояние твиков"/>
                </Grid>
            </Border>

            <ui:ProgressRing Grid.Row="3"
                             Width="32" Height="32"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,4,6,0"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Page>