<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" xmlns:vm="clr-namespace:Cleaner.App.ViewModels" x:Class="Cleaner.App.Views.OptimizePage" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:OptimizeViewModel}" Title="{loc:Loc t.optimizaciya}" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource BgBaseBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Grid>
                    <StackPanel Margin="0,0,46,0">
                        <TextBlock Text="{loc:Loc t.optimizaciya}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Icon="{ui:SymbolIcon QuestionCircle24}" Command="{Binding ToggleHelpCommand}" ToolTip="{loc:Loc help.show}" />
                </Grid>
                <ui:InfoBar Margin="0,16,0,0" Severity="Informational" Title="{loc:Loc help.optimize.title}" Message="{loc:Loc help.optimize.msg}" IsClosable="True" IsOpen="{Binding ShowHelp, Mode=TwoWay}" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="PresetChipStyle" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom" Padding="8" Width="36" Height="36" FontSize="12" Icon="{ui:SymbolIcon Dismiss24}" AutomationProperties.Name="{loc:Loc t.sbrosit_vybor}" Command="{Binding ClearPresetCommand}" IsEnabled="{Binding HasSelectedPreset}" ToolTip="{loc:Loc t.sbrosit_vybor}" />
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{loc:Loc design.search.tweaks}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Content="{loc:Loc design.applied.only}" IsChecked="{Binding AppliedOnly, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
                <TextBlock Text="{loc:Loc compatibility.pending}" Style="{StaticResource SettingHintStyle}" Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" TextWrapping="Wrap" />
                <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Visibility="{Binding HasPresetNote, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PresetNoteText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
                <Border Margin="0,4,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource BgOverlayBrush}" BorderBrush="{DynamicResource CautionBrush}" BorderThickness="1" Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ConflictText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource CautionBrush}" />
                </Border>
            </StackPanel>
            <Border Grid.Row="4" Margin="0,10,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Left" Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="440" FontSize="13" />
                        <TextBlock Text="{Binding PendingRebootText}" Foreground="{DynamicResource CautionBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{Binding HasPendingReboot, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Margin="8,0" Padding="12,8" FontSize="13" Appearance="Primary" Style="{StaticResource PrimaryButtonStyle}" Icon="{ui:SymbolIcon Play24}" Content="{loc:Loc t.primenit_preset_2}" Command="{Binding ApplyPresetCommand}" ToolTip="{loc:Loc t.primenit_vse_tviki_vybrannogo_preseta}" />
                    <ui:Button Grid.Column="2" Margin="8,0" Padding="12,8" FontSize="13" Icon="{ui:SymbolIcon ArrowUndo24}" Content="{loc:Loc t.otkatit_vse}" Command="{Binding RollbackAllCommand}" ToolTip="{loc:Loc t.vosstanovit_vse_znacheniya_iz_bekapa}" />
                    <ui:Button Grid.Column="3" Padding="12,8" FontSize="13" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="{loc:Loc t.obnovit}" Command="{Binding RefreshCommand}" ToolTip="{loc:Loc t.perechitat_sostoyanie_tvikov}" />
                </Grid>
            </Border>
            <ui:ProgressRing Grid.Row="3" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource BgOverlayBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,7" CornerRadius="4,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc graphite.name}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc graphite.consequence}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{loc:Loc graphite.risk}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="{loc:Loc graphite.state}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" Margin="0" MinHeight="100" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CategoryCardStyle}" Margin="0,0,0,6" Visibility="{Binding HasVisibleTweaks, Converter={StaticResource BoolToVis}}">
                                    <Expander Style="{StaticResource CompactCategoryStyle}" IsExpanded="True" AutomationProperties.Name="{Binding Name}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="16" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Tweaks}" Margin="4,2,4,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CompactRowStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="86" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="1" Height="Auto" CornerRadius="6" VerticalAlignment="Center" Margin="4,0,8,0" ToolTip="{Binding LevelHint}" HorizontalAlignment="Center" MinWidth="76" Padding="6,2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Level}" Value="safe">
                                                                                <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource SafeBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="caution">
                                                                                <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource CautionBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="danger">
                                                                                <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                        <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding LevelLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <Expander Style="{StaticResource CompactExpanderStyle}" Margin="0" FontSize="12" AutomationProperties.Name="{Binding Name}" ToolTip="{loc:Loc design.details}" Padding="0">
                                                                    <Expander.Header>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="3*" />
                                                                                <ColumnDefinition Width="4*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="Normal" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" Margin="0,0,10,0" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                                <WrapPanel Margin="0,0,8,0">
                                                                                    <Border Background="{DynamicResource CautionBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="{loc:Loc t.tvik_trebuet_perezagruzki}" Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                                                                        <TextBlock Text="{loc:Loc design.reboot}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding CompatibilityLabel}" ToolTip="{Binding CompatibilityText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0" LineHeight="14" LineStackingStrategy="BlockLineHeight" />
                                                                                </WrapPanel>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock HorizontalAlignment="Stretch" Text="{Binding Short}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" MaxWidth="9999" Margin="0" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" ToolTip="{Binding Short}" />
                                                                                <TextBlock HorizontalAlignment="Stretch" Text="{Binding Warn}" FontSize="12" Foreground="{DynamicResource CautionBrush}" TextWrapping="NoWrap" MaxWidth="640" Margin="0" Visibility="{Binding HasWarn, Converter={StaticResource BoolToVis}}" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" ToolTip="{Binding Warn}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Expander.Header>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,12,8" />
                                                                        <TextBlock Text="{Binding CompatibilityText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,12,8" />
                                                                        <TextBlock Text="{Binding Warn}" Foreground="{DynamicResource CautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,8" Visibility="{Binding HasWarn, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Text="{Binding CompatibilityText}" ToolTip="{Binding CompatibilityText}" FontSize="12" Foreground="{DynamicResource CautionBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCompatible}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Expander>
                                                                <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" ToolTip="{Binding LastError}" Foreground="{DynamicResource CautionBrush}" MaxWidth="640" Margin="0,3,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                            <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding IsApplied, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" OnContent="" OffContent="" HorizontalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>