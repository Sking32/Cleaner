<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" x:Class="Cleaner.App.Views.CleanupPage" Title="{loc:Loc t.ochistka}" Background="{DynamicResource BgBaseBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SummaryColumn" Width="224" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2">
            <Grid>
                <TextBlock Text="{loc:Loc t.ochistka}" Style="{StaticResource PageTitleStyle}" />
                <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Icon="{ui:SymbolIcon QuestionCircle24}" Command="{Binding ToggleHelpCommand}" ToolTip="{loc:Loc help.show}" />
            </Grid>
            <TextBlock Text="{loc:Loc design.cleanup.subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,40,0" />
            <ui:InfoBar Title="{loc:Loc help.cleanup.title}" Message="{loc:Loc help.cleanup.msg}" IsClosable="True" IsOpen="{Binding ShowHelp, Mode=TwoWay}" Margin="0,14,0,0" />
        </StackPanel>
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="5" Margin="0,10,0,8">
            <Border Padding="8,4" Margin="0,0,6,0" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="0">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.select}" FontSize="12" />
            </Border>
            <Border Padding="8,4" Margin="0,0,6,0" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="1">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.preview}" FontSize="12" />
            </Border>
            <Border Padding="8,4" Margin="0,0,6,0" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="2">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.confirm}" FontSize="12" />
            </Border>
            <Border Padding="8,4" Margin="0,0,6,0" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="3">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.execute}" FontSize="12" />
            </Border>
            <Border Padding="8,4" Margin="0,0,6,0" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="4">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.result}" FontSize="12" />
            </Border>
        </UniformGrid>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8" IsEnabled="{Binding CanEditSelection}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ui:Button x:Name="SelectAllButton" Content="{loc:Loc cleanup.selection.all}" Command="{Binding SelectAllCommand}" Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" ToolTip="{loc:Loc cleanup.selection.all.hint}" AutomationProperties.Name="{loc:Loc cleanup.selection.all}" />
                    <ui:Button x:Name="SelectNoneButton" Content="{loc:Loc cleanup.selection.none}" Command="{Binding SelectNoneCommand}" Appearance="Secondary" Padding="10,5" ToolTip="{loc:Loc cleanup.selection.none.hint}" AutomationProperties.Name="{loc:Loc cleanup.selection.none}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanEditSelection}" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc presets.custom}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,6,0" />
                    <ComboBox Width="125" ItemsSource="{Binding CustomPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCustomPreset}" ToolTip="{loc:Loc presets.custom}" AutomationProperties.Name="{loc:Loc presets.custom}" />
                    <ui:Button Icon="{ui:SymbolIcon Save24}" Command="{Binding EditPresetCommand}" Appearance="Transparent" Padding="6" Margin="4,0,0,0" ToolTip="{loc:Loc presets.save}" AutomationProperties.Name="{loc:Loc presets.save}" />
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeletePresetCommand}" Appearance="Transparent" Padding="6" ToolTip="{loc:Loc presets.delete}" AutomationProperties.Name="{loc:Loc presets.delete}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" IsEnabled="{Binding CanEditSelection}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource PresetChipStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding Short}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding CanEditSelection}" Visibility="{Binding PresetEditorOpen, Converter={StaticResource BoolToVis}}">
                <TextBox Width="220" MaxLength="60" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc presets.name}" AutomationProperties.Name="{loc:Loc presets.name}" />
                <ui:Button Content="{loc:Loc presets.save}" Command="{Binding SavePresetCommand}" Margin="8,0,0,0" />
                <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding EditPresetCommand}" Appearance="Transparent" ToolTip="{loc:Loc t.otmena}" AutomationProperties.Name="{loc:Loc t.otmena}" />
            </StackPanel>
            <StackPanel x:Name="CompactSummary" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Text="{Binding CompactSummary}" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
                <ComboBox ItemsSource="{Binding FileModes}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding FileMode, Mode=TwoWay}" ToolTip="{Binding FileModeHint}" AutomationProperties.Name="{loc:Loc cleanup.mode.title}" Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="220" IsEnabled="{Binding CanEditSelection}" FontSize="12" />
            </StackPanel>
            <TextBlock Text="{Binding PresetNoteText}" Style="{StaticResource PageSubtitleStyle}" Visibility="{Binding HasPresetNote, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0" />
        </StackPanel>
        <TabControl x:Name="OperationTabs" Grid.Row="3" Grid.Column="0" SelectedIndex="{Binding ResultTabIndex}" Margin="0,0,12,0" Background="Transparent" BorderThickness="0">
            <TabItem Header="{loc:Loc preview.selection}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource BgOverlayBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="66,7,36,7" CornerRadius="4,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{loc:Loc graphite.name}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc graphite.consequence}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        </Grid>
                    </Border>
                    <ScrollViewer IsEnabled="{Binding CanEditSelection}" VerticalScrollBarVisibility="Auto" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CategoryCardStyle}" Margin="0,0,0,6">
                                        <Expander Style="{StaticResource CompactCategoryStyle}" IsExpanded="True" AutomationProperties.Name="{Binding Name}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="16" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Operations.Count, StringFormat=' • {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Operations}" Margin="4,2,4,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource CompactRowStyle}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Бейдж уровня -->
                                                                <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" VerticalContentAlignment="Top" ToolTip="{Binding Description}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
                                                                <Border Grid.Column="1" Width="22" Height="22" CornerRadius="6" VerticalAlignment="Top" Margin="0,3,10,0" ToolTip="{Binding LevelHint}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Level}" Value="safe">
                                                                                    <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SafeBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="medium">
                                                                                    <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CautionBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="caution">
                                                                                    <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CautionBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="danger">
                                                                                    <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                            <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}" />
                                                                            <Setter Property="BorderThickness" Value="1" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding LevelShort}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <!-- Текст -->
                                                                <StackPanel Grid.Column="2">
                                                                    <Expander Style="{StaticResource CompactExpanderStyle}" FontSize="12" Margin="0" AutomationProperties.Name="{Binding Name}" ToolTip="{loc:Loc design.details}">
                                                                        <Expander.Header>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="Normal" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                                <TextBlock Text="{Binding Consequence}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Consequence}" Margin="0" Grid.Column="1" VerticalAlignment="Center" />
                                                                            </Grid>
                                                                        </Expander.Header>
                                                                        <StackPanel Margin="0,8,8,8">
                                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                            <TextBlock Text="{Binding Consequence}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                                                            <TextBlock Text="{Binding Applicability}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                                                            <TextBlock Text="{Binding Reversibility}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                                                        </StackPanel>
                                                                    </Expander>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:Loc preview.results}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,8,0,8">
                        <TextBlock Text="{Binding CategorySummary}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource SettingHintStyle}" />
                        <TextBlock Text="{loc:Loc preview.empty}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingHintStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResults}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ResultRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowBorderStyle}" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{DynamicResource AccentBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding CategoryText}" Style="{StaticResource SettingHintStyle}" />
                                            <TextBlock Text="{Binding MethodText}" FontSize="12" Margin="0,4,0,0" />
                                            <Expander Style="{StaticResource CompactExpanderStyle}" Header="{Binding StatusText}" IsExpanded="{Binding IsHighlighted, Mode=TwoWay}" Margin="0,4,0,0">
                                                <TextBox Text="{Binding DetailsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,6,0,0" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:Loc analytics.categories}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{loc:Loc analytics.categories.hint}" Style="{StaticResource SettingHintStyle}" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding CategoryChart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,0,8" Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Name}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
                                            </Grid>
                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderStrongBrush}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Loc analytics.categories.empty}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingHintStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCategoryChart}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border x:Name="SelectionSummary" Grid.Row="3" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{loc:Loc design.cleanup.selection}" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{Binding PreviewSizeText}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock Text="{Binding CheckedCount}" Style="{StaticResource NumberTextStyle}" Margin="0,0,6,0" FontSize="12" />
                        <TextBlock Text="{loc:Loc design.cleanup.operations}" Style="{StaticResource SettingHintStyle}" Margin="0" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Loc cleanup.mode.title}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,14,0,0" VerticalAlignment="Center" />
                    <ComboBox Width="Auto" ItemsSource="{Binding FileModes}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding FileMode, Mode=TwoWay}" ToolTip="{Binding FileModeHint}" AutomationProperties.Name="{loc:Loc cleanup.mode.title}" HorizontalAlignment="Stretch" Margin="0,6,0,0" IsEnabled="{Binding CanEditSelection}" FontSize="12" />
                    <Border Style="{StaticResource DividerStyle}" Margin="0,12" />
                    <TextBlock Text="{Binding FileModeHint}" Style="{StaticResource SettingHintStyle}" Margin="0" />
                    <TextBlock Text="{loc:Loc design.cleanup.estimate}" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,0" />
                    <TextBlock Text="{loc:Loc design.cleanup.estimate.hint}" Style="{StaticResource SettingHintStyle}" />
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource SettingHintStyle}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" MaxHeight="54" ToolTip="{Binding StatusText}" />
                    <TextBlock Text="{Binding BytesFreedText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" Margin="0,0,12,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                        <ui:Button Content="{loc:Loc analytics.check}" Icon="{ui:SymbolIcon Search24}" Command="{Binding AnalyzeCommand}" ToolTip="{loc:Loc preview.analyze}" AutomationProperties.Name="{loc:Loc preview.analyze}" Padding="8" Margin="0,0,8,0" />
                        <ui:Button Appearance="Primary" Style="{StaticResource PrimaryButtonStyle}" Icon="{ui:SymbolIcon Play24}" Content="{Binding RunButtonText}" Command="{Binding RunCommand}" Padding="14,8" />
                        <ui:Button Content="{loc:Loc t.otmena}" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="12,8" />
                    </StackPanel>
                    <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ExportReportCommand}" ToolTip="{loc:Loc report.export}" AutomationProperties.Name="{loc:Loc report.export}" Appearance="Transparent" Margin="8,0,0,0" Padding="8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>