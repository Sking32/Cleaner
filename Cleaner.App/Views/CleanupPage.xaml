<Page x:Class="Cleaner.App.Views.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:CleanupViewModel}"
      Title="Очистка">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Очистка" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Выберите пресет или отметьте операции вручную."
                       Margin="0,8,0,0" Opacity="0.75"/>
        </StackPanel>

        <!-- Пресеты -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Пресет" Opacity="0.75" Margin="0,0,0,4"/>
                <ComboBox Width="320"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                          ToolTip="Мягкая — только temp. Стандартная — + отчёты и логи. Глубокая — + браузеры, приложения и DISM.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Short}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <ui:InfoBar Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Bottom"
                        Severity="Informational"
                        Title="Подсказка"
                        Message="{Binding PresetNoteText}"
                        IsClosable="False"
                        IsOpen="{Binding HasPresetNote, Mode=OneWay}"
                        Visibility="{Binding HasPresetNote, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Список операций -->
        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander Margin="0,0,0,8"
                                         IsExpanded="True"
                                         Header="{Binding Name}">
                            <ui:CardExpander.Icon>
                                <ui:SymbolIcon Symbol="{Binding IconSymbol}"/>
                            </ui:CardExpander.Icon>

                            <ItemsControl ItemsSource="{Binding Operations}" Margin="4,4,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="0,4"
                                                  ToolTip="{Binding Description}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="20" Height="20"
                                                        CornerRadius="10"
                                                        VerticalAlignment="Top"
                                                        Margin="0,2,8,0"
                                                        ToolTip="{Binding LevelLabel}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#404040"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="safe">
                                                                    <Setter Property="Background" Value="#1B5E20"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="medium">
                                                                    <Setter Property="Background" Value="#8D6E00"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="danger">
                                                                    <Setter Property="Background" Value="#8B1A1A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding LevelShort}"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11"
                                                               Opacity="0.7"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="640"/>
                                                    <TextBlock Text="{Binding Hint}"
                                                               FontSize="11"
                                                               Foreground="#E5A000"
                                                               Margin="0,2,0,0"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="640"
                                                               Visibility="{Binding Hint, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" MaxWidth="620"/>
                <TextBlock Text="{Binding BytesFreedText}" Opacity="0.75" FontSize="11"/>
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Margin="8,0"
                       Padding="20,10"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Play24}"
                       Content="{Binding CheckedCount, StringFormat=Запустить ({0})}"
                       Command="{Binding RunCommand}"
                       ToolTip="Запустить выбранные операции очистки"/>

            <ui:Button Grid.Column="2"
                       Padding="20,10"
                       Icon="{ui:SymbolIcon Stop24}"
                       Content="Отмена"
                       Command="{Binding CancelCommand}"
                       ToolTip="Отменить текущую очистку"/>
        </Grid>

        <ui:ProgressRing Grid.Row="2"
                         Width="28" Height="28"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,4,4,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Page>