<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" x:Class="Cleaner.App.Views.CleanupPage" Title="{loc:Loc t.ochistka}" Background="{DynamicResource BgBaseBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid Margin="24,20,24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="208"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2">
            <Grid>
                <TextBlock Text="{loc:Loc t.ochistka}" Style="{StaticResource PageTitleStyle}"/>
                <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Icon="{ui:SymbolIcon QuestionCircle24}" Command="{Binding ToggleHelpCommand}" ToolTip="{loc:Loc help.show}"/>
            </Grid>
            <TextBlock Text="{loc:Loc design.cleanup.subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,40,0"/>
            <ui:InfoBar Title="{loc:Loc help.cleanup.title}" Message="{loc:Loc help.cleanup.msg}" IsClosable="True" IsOpen="{Binding ShowHelp, Mode=TwoWay}" Margin="0,14,0,0"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="5" Margin="0,12,0,10">
            <Border Padding="10,5" Margin="0,0,6,0" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="0">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.select}" FontSize="12"/>
            </Border>
            <Border Padding="10,5" Margin="0,0,6,0" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="1">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.preview}" FontSize="12"/>
            </Border>
            <Border Padding="10,5" Margin="0,0,6,0" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="2">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.confirm}" FontSize="12"/>
            </Border>
            <Border Padding="10,5" Margin="0,0,6,0" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="3">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.execute}" FontSize="12"/>
            </Border>
            <Border Padding="10,5" Margin="0,0,6,0" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStage}" Value="4">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{loc:Loc design.step.result}" FontSize="12"/>
            </Border>
        </UniformGrid>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8" IsEnabled="{Binding CanEditSelection}">
            <TextBlock Text="{loc:Loc t.preset_3}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource PresetChipStyle}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel ToolTip="{Binding Short}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding PresetNoteText}" Style="{StaticResource PageSubtitleStyle}" Visibility="{Binding HasPresetNote, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="3" Grid.Column="0" IsEnabled="{Binding CanEditSelection}" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CategoryCardStyle}" Margin="0,0,0,6">
                            <Expander Style="{StaticResource CompactCategoryStyle}" IsExpanded="True" AutomationProperties.Name="{Binding Name}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Operations.Count, StringFormat=' • {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Operations}" Margin="4,2,4,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CompactRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Бейдж уровня -->
                                                    <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalContentAlignment="Top" ToolTip="{Binding Description}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0"/>
                                                    <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top" Margin="0,3,10,0" ToolTip="{Binding LevelHint}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#3A3A3A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="safe">
                                                                        <Setter Property="Background" Value="#1B5E20"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="medium">
                                                                        <Setter Property="Background" Value="#8D6E00"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="caution">
                                                                        <Setter Property="Background" Value="#8D6E00"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="danger">
                                                                        <Setter Property="Background" Value="#8B1A1A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding LevelShort}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Текст -->
                                                    <StackPanel Grid.Column="2">
                                                        <Expander Style="{StaticResource CompactExpanderStyle}" FontSize="11" Margin="0" AutomationProperties.Name="{Binding Name}" ToolTip="{loc:Loc design.details}">
                                                            <Expander.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                                    <TextBlock HorizontalAlignment="Left" Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="720" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Expander.Header>
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,8,8"/>
                                                        </Expander>
                                                        <TextBlock HorizontalAlignment="Left" Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource CautionBrush}" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="720" Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{loc:Loc design.cleanup.selection}" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="{Binding CheckedCount}" Style="{StaticResource NumberTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock Text="{loc:Loc design.cleanup.operations}" Style="{StaticResource SettingHintStyle}"/>
                    <Border Style="{StaticResource DividerStyle}" Margin="0,20"/>
                    <TextBlock Text="{loc:Loc design.cleanup.estimate}" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="{Binding PreviewSizeText}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="{loc:Loc design.cleanup.estimate.hint}" Style="{StaticResource SettingHintStyle}"/>
                    <Border Style="{StaticResource DividerStyle}" Margin="0,20"/>
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" FontSize="22"/>
                    <TextBlock Text="{loc:Loc design.cleanup.recovery}" Style="{StaticResource SettingHintStyle}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource SettingHintStyle}" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" MaxHeight="54" ToolTip="{Binding StatusText}"/>
                    <TextBlock Text="{Binding BytesFreedText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" Margin="0,0,12,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <ui:Button Appearance="Primary" Style="{StaticResource PrimaryButtonStyle}" Icon="{ui:SymbolIcon Play24}" Content="{Binding RunButtonText}" Command="{Binding RunCommand}" Padding="14,8"/>
                        <ui:Button Content="{loc:Loc t.otmena}" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="12,8"/>
                    </StackPanel>
                    <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ExportReportCommand}" ToolTip="{loc:Loc report.export}" AutomationProperties.Name="{loc:Loc report.export}" Appearance="Transparent" Margin="8,0,0,0" Padding="8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
