<Page x:Class="Cleaner.App.Views.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:CleanupViewModel}"
      Title="Очистка"
      Foreground="#FFFFFF">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Градиентная подложка шапки -->
        <Border Height="220"
                VerticalAlignment="Top"
                Background="{StaticResource PageHeaderBrush}"/>

        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!--  ШАПКА                                                       -->
            <!-- ============================================================ -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="52" Height="52"
                        CornerRadius="14"
                        Background="{StaticResource AccentGradientBrush}"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Broom24"
                                   FontSize="26"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Очистка"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="Выберите пресет или отметьте операции вручную"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ============================================================ -->
            <!--  ПРЕСЕТЫ                                                     -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Пресет"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8"/>
                    <ListBox ItemsSource="{Binding Presets}"
                             SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalAlignment="Left"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="PresetChipStyle"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <TextBlock Text="{Binding Short}"
                                               FontSize="10"
                                               Opacity="0.75"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <ui:InfoBar Grid.Column="1"
                            Margin="20,22,0,0"
                            VerticalAlignment="Bottom"
                            Severity="Informational"
                            Title="Подсказка"
                            Message="{Binding PresetNoteText}"
                            IsClosable="False"
                            IsOpen="{Binding HasPresetNote, Mode=OneWay}"
                            Visibility="{Binding HasPresetNote, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- ============================================================ -->
            <!--  ОТБИВКА                                                     -->
            <!-- ============================================================ -->
            <Border Grid.Row="2"
                    Height="1"
                    Margin="0,20,0,0"
                    Background="#18FFFFFF"/>

            <!-- ============================================================ -->
            <!--  КАТЕГОРИИ                                                   -->
            <!-- ============================================================ -->
            <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CategoryCardStyle}" Margin="0,0,0,10">
                                <ui:CardExpander IsExpanded="True">
                                    <ui:CardExpander.Icon>
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}"
                                                       FontSize="16"/>
                                    </ui:CardExpander.Icon>
                                    <ui:CardExpander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Operations.Count, StringFormat=' • {0}'}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </ui:CardExpander.Header>

                                    <ItemsControl ItemsSource="{Binding Operations}" Margin="4,2,4,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowBorderStyle}">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              VerticalContentAlignment="Top"
                                                              ToolTip="{Binding Description}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Бейдж уровня -->
                                                            <Border Grid.Column="0"
                                                                    Width="22" Height="22"
                                                                    CornerRadius="11"
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,3,10,0"
                                                                    ToolTip="{Binding LevelLabel}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#3A3A3A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Level}" Value="safe">
                                                                                <Setter Property="Background" Value="#1B5E20"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="medium">
                                                                                <Setter Property="Background" Value="#8D6E00"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="caution">
                                                                                <Setter Property="Background" Value="#8D6E00"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="danger">
                                                                                <Setter Property="Background" Value="#8B1A1A"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding LevelShort}"
                                                                           Foreground="White"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Текст -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="13"
                                                                           Foreground="#FFFFFF"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="720"
                                                                           Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding Hint}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource CautionBrush}"
                                                                           Margin="0,3,0,0"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="720"
                                                                           Visibility="{Binding Hint, Converter={StaticResource BoolToVis}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ui:CardExpander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ============================================================ -->
            <!--  ФУТЕР                                                       -->
            <!-- ============================================================ -->
            <Border Grid.Row="4"
                    Margin="0,16,0,0"
                    Padding="16,12"
                    CornerRadius="12"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap"
                                   MaxWidth="620"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding BytesFreedText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Margin="8,0"
                               Padding="24,12"
                               FontSize="14"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Play24}"
                               Content="{Binding RunButtonText}"
                               Command="{Binding RunCommand}"
                               ToolTip="Запустить выбранные операции очистки"/>

                    <ui:Button Grid.Column="2"
                               Padding="24,12"
                               FontSize="14"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Content="Отмена"
                               Command="{Binding CancelCommand}"
                               ToolTip="Отменить текущую очистку"/>
                </Grid>
            </Border>

            <!-- Прогресс в углу -->
            <ui:ProgressRing Grid.Row="3"
                             Width="32" Height="32"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,4,6,0"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Page>