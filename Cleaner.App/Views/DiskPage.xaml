<Page x:Class="Cleaner.App.Views.DiskPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" xmlns:controls="clr-namespace:Cleaner.App.Controls" xmlns:vm="clr-namespace:Cleaner.App.ViewModels" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DiskViewModel}" Title="{loc:Loc t.disk}" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource BgBaseBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Шапка -->
            <StackPanel Grid.Row="0">
                <Grid>
                    <StackPanel Margin="0,0,46,0">
                        <TextBlock Text="{loc:Loc t.disk}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{loc:Loc t.analiz_zanyatogo_mesta_krupnye_papki_i}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Icon="{ui:SymbolIcon QuestionCircle24}" Command="{Binding ToggleHelpCommand}" ToolTip="{loc:Loc help.show}" />
                </Grid>
                <ui:InfoBar Margin="0,16,0,0" Severity="Informational" Title="{loc:Loc help.disk.title}" Message="{loc:Loc help.disk.msg}" IsClosable="True" IsOpen="{Binding ShowHelp, Mode=TwoWay}" />
            </StackPanel>
            <!-- Управление -->
            <!-- Результаты -->
            <TabControl Grid.Row="2" Margin="0,8,0,0" Padding="0" Background="Transparent" BorderThickness="0">
                <TabItem Header="{loc:Loc ui.disk.tab.map}">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.15*" MinHeight="200" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}" Margin="0" Padding="10" Grid.Column="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ItemsControl Grid.Row="0" ItemsSource="{Binding Breadcrumbs}" Margin="0,0,0,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Appearance="Transparent" Padding="8,2" Content="{Binding Title}" Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,0,0,8">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTreemapBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <controls:TreemapView x:Name="DiskMap" Grid.Row="2" ClipToBounds="True" Nodes="{Binding TreemapNodes}" ActivateCommand="{Binding OpenTreemapNodeCommand}" OpenLocationCommand="{Binding OpenMapLocationCommand}" SelectedNode="{Binding MapSelection}" />
                                <TextBlock Grid.Row="3" Text="{Binding MapSelectionText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" MaxHeight="72" ToolTip="{Binding MapSelectionText}" />
                                <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="{loc:Loc ui.disk.map.empty}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNoTreemap}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Border Margin="0" Style="{StaticResource CategoryCardStyle}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc analytics.disk.used}" FontSize="14" FontWeight="SemiBold" />
                                <controls:DiskGauge Percent="{Binding SelectedDrive.UsedPercent, Mode=OneWay, FallbackValue=NaN, TargetNullValue=NaN}" NoDataText="{loc:Loc analytics.no.data}" Height="116" AutomationProperties.Name="{Binding CapacityText}" VerticalAlignment="Center" Grid.Row="1" Margin="0,2" />
                                <TextBlock Text="{Binding CapacityText}" Style="{StaticResource SettingHintStyle}" TextWrapping="Wrap" Grid.Row="2" Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="0" Style="{StaticResource CategoryCardStyle}" Padding="0" Grid.Row="2" Grid.ColumnSpan="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,6">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{loc:Loc t.top_papok}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{DynamicResource BgOverlayBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,7" CornerRadius="4,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc graphite.name}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{loc:Loc graphite.path}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                            <TextBlock Grid.Column="2" Text="{loc:Loc graphite.size}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="0">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc t.nazhmite_analiz_poyavitsya_spisok_samyh_tyaz}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasNoResults}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding TopFolders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource RowBorderStyle}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="4*" />
                                                                    <ColumnDefinition Width="100" />
                                                                    <ColumnDefinition Width="42" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0" />
                                                                <ui:Button Grid.Column="3" Padding="6,2" Icon="{ui:SymbolIcon Folder24}" ToolTip="{loc:Loc t.otkryt_v_provodnike}" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <TextBlock ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{Binding Name}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="{loc:Loc ui.disk.tab.lists}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Папки -->
                        <!-- Крупные файлы -->
                        <Border Grid.Column="0" Style="{StaticResource CategoryCardStyle}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{loc:Loc t.krupnye_fayly}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox Width="140" Margin="14,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding FileFilters}" SelectedIndex="{Binding FileFilterIndex, Mode=TwoWay}" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid>
                                        <TextBlock Text="{loc:Loc t.top_faylov_poyavitsya_posle_analiza_diska}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNoResults}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox ItemsSource="{Binding LargeFiles}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource RowBorderStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ui:Button Padding="6,2" Icon="{ui:SymbolIcon Folder24}" ToolTip="{loc:Loc t.pokazat_v_provodnike}" Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <ui:Button Padding="6,2" Margin="4,0,0,0" Icon="{ui:SymbolIcon Delete24}" ToolTip="{loc:Loc ui.disk.quarantine.tooltip}" Command="{Binding DataContext.QuarantineFileCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            <!-- Футер -->
            <Border Grid.Row="3" Margin="0,8,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Margin="8,0" Padding="12,7" FontSize="13" Icon="{ui:SymbolIcon DocumentText24}" Content="{loc:Loc t.tenevye_kopii}" ToolTip="{loc:Loc t.pokazat_spisok_tenevyh_kopiy}" Command="{Binding ListShadowsCommand}" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Grid.Column="2" Padding="12,7" FontSize="13" Icon="{ui:SymbolIcon Delete24}" Content="{loc:Loc t.udalit_starye}" ToolTip="{loc:Loc compatibility.pending}" Command="{Binding DeleteOldShadowsCommand}" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
            <ui:ProgressRing Grid.Row="2" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ProgressText}" ToolTip="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="1" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" DisplayMemberPath="Display" VerticalAlignment="Center" IsEnabled="{Binding CanSelectDrive}" MinHeight="34" Width="240" />
                    <ui:Button Grid.Column="1" Margin="10,0,0,0" Padding="14,8" Appearance="Primary" Style="{StaticResource PrimaryButtonStyle}" Icon="{ui:SymbolIcon Play24}" Content="{loc:Loc t.analiz}" Command="{Binding ScanCommand}" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="14,8" Icon="{ui:SymbolIcon Dismiss24}" Content="{loc:Loc t.otmena}" Command="{Binding CancelCommand}" />
                </Grid>
            </Grid>
        </Grid>
        <!-- Окно с текстом теневых копий: показываем как подсказку в статус-баре -->
        <Border x:Name="ShadowPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,100" MaxWidth="600" MaxHeight="300" Padding="12,8" CornerRadius="6" Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Visibility="{Binding HasShadowText, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ShadowText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>