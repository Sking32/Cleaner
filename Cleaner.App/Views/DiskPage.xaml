<Page x:Class="Cleaner.App.Views.DiskPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" xmlns:controls="clr-namespace:Cleaner.App.Controls" xmlns:vm="clr-namespace:Cleaner.App.ViewModels" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DiskViewModel}" Title="{loc:Loc t.disk}" Foreground="{StaticResource TextPrimaryBrush}" Background="{DynamicResource BgBaseBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid>
        <Grid Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Шапка -->
            <StackPanel Grid.Row="0">
                <Grid>
                    <StackPanel Margin="0,0,46,0">
                        <TextBlock Text="{loc:Loc t.disk}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{loc:Loc t.analiz_zanyatogo_mesta_krupnye_papki_i}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Icon="{ui:SymbolIcon QuestionCircle24}" Command="{Binding ToggleHelpCommand}" ToolTip="{loc:Loc help.show}" />
                </Grid>
                <ui:InfoBar Margin="0,16,0,0" Severity="Informational" Title="{loc:Loc help.disk.title}" Message="{loc:Loc help.disk.msg}" IsClosable="True" IsOpen="{Binding ShowHelp, Mode=TwoWay}" />
            </StackPanel>
            <!-- Управление -->
            <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CategoryCardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" DisplayMemberPath="Display" VerticalAlignment="Center" IsEnabled="{Binding CanSelectDrive}" MinHeight="34" />
                        <ui:Button Grid.Column="1" Margin="10,0,0,0" Padding="20,10" Appearance="Primary" Style="{StaticResource PrimaryButtonStyle}" Icon="{ui:SymbolIcon Play24}" Content="{loc:Loc t.analiz}" ToolTip="{loc:Loc t.proskanirovat_vybrannyy_disk}" Command="{Binding ScanCommand}" />
                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="20,10" Icon="{ui:SymbolIcon Dismiss24}" Content="{loc:Loc t.otmena}" Command="{Binding CancelCommand}" />
                    </Grid>
                    <!-- Прогресс / сводка -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <ProgressBar Height="6" Margin="0,0,0,10" Minimum="0" Maximum="100" Value="{Binding SelectedDrive.UsedPercent, Mode=OneWay}" />
                        <TextBlock ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding ProgressText}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0" Text="{Binding SummaryText}" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Результаты -->
            <TabControl Grid.Row="2" Margin="0,14,0,0" Padding="0" Background="Transparent" BorderThickness="0">
                <TabItem Header="{loc:Loc ui.disk.tab.map}">
                    <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding Breadcrumbs}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Appearance="Transparent" Padding="8,2" Content="{Binding Title}" Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,0,0,8">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTreemapBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <controls:TreemapView Grid.Row="2" MinHeight="260" Nodes="{Binding TreemapNodes}" ActivateCommand="{Binding OpenTreemapNodeCommand}" />
                            <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="{loc:Loc ui.disk.map.empty}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoTreemap}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="{loc:Loc ui.disk.tab.lists}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Папки -->
                        <Border Grid.Column="0" Style="{StaticResource CategoryCardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{loc:Loc t.top_papok}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="200">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc t.nazhmite_analiz_poyavitsya_spisok_samyh_tyaz}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNoResults}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding TopFolders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource RowBorderStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0" />
                                                            <ui:Button Grid.Column="2" Padding="6,2" Icon="{ui:SymbolIcon Folder24}" ToolTip="{loc:Loc t.otkryt_v_provodnike}" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <!-- Крупные файлы -->
                        <Border Grid.Column="2" Style="{StaticResource CategoryCardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{loc:Loc t.krupnye_fayly}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox Width="140" Margin="14,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding FileFilters}" SelectedIndex="{Binding FileFilterIndex, Mode=TwoWay}" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="200">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc t.top_faylov_poyavitsya_posle_analiza_diska}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNoResults}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding LargeFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource RowBorderStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ui:Button Padding="6,2" Icon="{ui:SymbolIcon Folder24}" ToolTip="{loc:Loc t.pokazat_v_provodnike}" Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <ui:Button Padding="6,2" Margin="4,0,0,0" Icon="{ui:SymbolIcon Delete24}" ToolTip="{loc:Loc ui.disk.quarantine.tooltip}" Command="{Binding DataContext.QuarantineFileCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            <!-- Футер -->
            <Border Grid.Row="3" Margin="0,16,0,0" Padding="16,12" CornerRadius="12" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Margin="8,0" Padding="16,10" FontSize="13" Icon="{ui:SymbolIcon DocumentText24}" Content="{loc:Loc t.tenevye_kopii}" ToolTip="{loc:Loc t.pokazat_spisok_tenevyh_kopiy}" Command="{Binding ListShadowsCommand}" />
                    <ui:Button Grid.Column="2" Padding="16,10" FontSize="13" Icon="{ui:SymbolIcon Delete24}" Content="{loc:Loc t.udalit_starye}" ToolTip="{loc:Loc t.udalit_starye_tenevye_kopii_nuzhny_prava}" Command="{Binding DeleteOldShadowsCommand}" />
                </Grid>
            </Border>
            <ui:ProgressRing Grid.Row="2" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
        </Grid>
        <!-- Окно с текстом теневых копий: показываем как подсказку в статус-баре -->
        <Border x:Name="ShadowPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,100" MaxWidth="600" MaxHeight="300" Padding="16,12" CornerRadius="12" Background="#1F1F1F" BorderBrush="#2D2D2D" BorderThickness="1" Visibility="{Binding HasShadowText, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ShadowText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="#C5C5C5" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
