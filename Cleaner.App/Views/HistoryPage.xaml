<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" x:Class="Cleaner.App.Views.HistoryPage" Background="{DynamicResource BgBaseBrush}" Title="{loc:Loc history.title}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:Loc history.title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:Loc history.subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,14" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc history.search}" ToolTip="{loc:Loc history.search}" />
            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="{loc:Loc history.refresh}" AutomationProperties.Name="{loc:Loc history.refresh}" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Margin="0,0,0,10" Padding="12,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded, ElementName=HistoryDetails}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{loc:Loc analytics.history.hint}" Style="{StaticResource SettingHintStyle}" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:Loc analytics.history.empty}" Style="{StaticResource SettingHintStyle}" Visibility="{Binding HasNoChart, Converter={StaticResource BoolToVis}}" />
                    <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,4">
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource SafeBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc analytics.deleted}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc analytics.quarantined}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </WrapPanel>
                    <Grid x:Name="HistoryPlot">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="116" VerticalAlignment="Top" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ChartMaximumText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ChartMidpointText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ChartZeroText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Grid.Column="1" Height="100" VerticalAlignment="Top" Margin="0,8,0,0">
                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,1" />
                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ChartItems}" Grid.Column="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="116" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="100" Margin="0,8">
                                            <Rectangle Height="{Binding DeletedPercent}" Width="13" Fill="{DynamicResource SafeBrush}" VerticalAlignment="Bottom" ToolTip="{Binding DeletedText}" AutomationProperties.Name="{Binding DeletedText}" Margin="0,0,4,0" />
                                            <Rectangle Height="{Binding QuarantinedPercent}" Width="13" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" ToolTip="{Binding QuarantinedText}" AutomationProperties.Name="{Binding QuarantinedText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding DeletedText}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding QuarantinedText}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Row="3" Text="{Binding DateText}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource CategoryCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource BgOverlayBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,7" CornerRadius="4,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc graphite.date}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc graphite.state}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc graphite.description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        </Grid>
                    </Border>
                    <ListBox ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding SelectedEntry}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding TimeText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SummaryText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="{loc:Loc history.empty}" TextWrapping="Wrap" Margin="8" Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVis}}" Grid.Row="1" />
                </Grid>
            </Border>
            <Expander x:Name="HistoryDetails" Grid.Row="2" Header="{loc:Loc design.details}" Style="{StaticResource CompactExpanderStyle}" IsExpanded="False" Margin="0,8,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{loc:Loc design.details}">
                <Border Style="{StaticResource CardStyle}" Height="240" Padding="12" Margin="0,6,0,0">
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedEntry.TimeText}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedEntry.StatusText}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedEntry.TotalsText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding SelectedEntry.ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding SelectedEntry.HasError, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{loc:Loc history.legacy}" Style="{StaticResource SettingHintStyle}" Visibility="{Binding SelectedEntry.IsLegacy, Converter={StaticResource BoolToVis}}" />
                            <WrapPanel Margin="0,12,0,14">
                                <ui:Button Content="{loc:Loc report.export}" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="{loc:Loc history.quarantine}" Command="{Binding OpenQuarantineCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedEntry.Outcomes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowBorderStyle}" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MethodText}" Style="{StaticResource SettingHintStyle}" />
                                                <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                                                <Expander Style="{StaticResource CompactExpanderStyle}" Header="{Binding StatusText}" Margin="0,4,0,0">
                                                    <TextBox Text="{Binding DetailsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,4,0,0" />
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Expander>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
    </Grid>
</Page>