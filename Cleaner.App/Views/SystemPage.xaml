<Page x:Class="Cleaner.App.Views.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SystemViewModel}"
      Title="Система"
      Foreground="#FFFFFF"
      Background="#0E0E10">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Border Height="220" VerticalAlignment="Top" Background="{StaticResource PageHeaderBrush}"/>

        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="52" Height="52"
                        CornerRadius="14"
                        Background="{StaticResource AccentGradientBrush}"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Desktop24"
                                   FontSize="26"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Система"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="Информация о системе и управление службами Windows"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Плитки информации -->
            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Style="{StaticResource CategoryCardStyle}"
                    Padding="18">
                <UniformGrid Columns="4" Rows="2">
                    <StackPanel Margin="4,6">
                        <TextBlock Text="Windows"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding WindowsVersion}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="4,6">
                        <TextBlock Text="Сборка"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding WindowsBuild}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="4,6">
                        <TextBlock Text="Архитектура"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Architecture}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="4,6">
                        <TextBlock Text=".NET"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding DotNetVersion}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="4,6">
                        <TextBlock Text="Компьютер"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding MachineName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="4,6">
                        <TextBlock Text="Пользователь"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding UserName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="4,6">
                        <TextBlock Text="ОЗУ / Ядра"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0">
                            <Run Text="{Binding TotalMemoryText, Mode=OneWay}"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding ProcessorCountText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="4,6">
                        <TextBlock Text="CPU"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ProcessorIdentifier}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ProcessorIdentifier}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Фильтр служб -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            PlaceholderText="Поиск службы по имени (пусто = только работающие)"
                            Text="{Binding ServiceFilter, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding FilteredServices.Count, StringFormat='Найдено: {0}'}"/>
            </Grid>

            <!-- Список служб -->
            <Border Grid.Row="3"
                    Margin="0,10,0,0"
                    Style="{StaticResource CategoryCardStyle}"
                    Padding="4">
                <Grid>
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="16,20,16,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Text="Службы не найдены. Измените фильтр.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoServices}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox ItemsSource="{Binding FilteredServices}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text=" • "
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text=" • "
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding StartTypeRu}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Статус -->
                                        <Border Grid.Column="1"
                                                Padding="8,2"
                                                CornerRadius="10"
                                                VerticalAlignment="Center"
                                                Margin="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#252525"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Background" Value="#1B5E20"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>

                                        <!-- Кнопки -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <ui:Button Padding="6,2"
                                                       Margin="0,0,4,0"
                                                       Icon="{ui:SymbolIcon Play24}"
                                                       ToolTip="Запустить"
                                                       IsEnabled="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"
                                                       Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"/>
                                            <!-- IsEnabled выше не сработает как нужно, заменим ниже -->
                                            <ui:Button Padding="6,2"
                                                       Margin="0,0,4,0"
                                                       Icon="{ui:SymbolIcon Dismiss24}"
                                                       ToolTip="Остановить"
                                                       Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Padding="6,2"
                                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                                       ToolTip="Перезапустить"
                                                       Command="{Binding DataContext.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Футер -->
            <Border Grid.Row="4"
                    Margin="0,16,0,0"
                    Padding="16,12"
                    CornerRadius="12"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap"
                                   MaxWidth="520"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding PendingRebootText}"
                                   Foreground="{StaticResource CautionBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Margin="8,0"
                               Padding="20,12"
                               FontSize="14"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Content="Сбросить флаги"
                               ToolTip="Сбросить статус «требуется перезагрузка» у твиков"
                               Command="{Binding ClearRebootFlagsCommand}"/>

                    <ui:Button Grid.Column="2"
                               Margin="8,0"
                               Padding="20,12"
                               FontSize="14"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Power24}"
                               Content="Перезагрузить"
                               ToolTip="Перезагрузить систему через 30 секунд"
                               Command="{Binding RebootNowCommand}"/>

                    <ui:Button Grid.Column="3"
                               Padding="20,12"
                               FontSize="14"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Content="Обновить"
                               Command="{Binding RefreshCommand}"/>
                </Grid>
            </Border>

            <ui:ProgressRing Grid.Row="3"
                             Width="32" Height="32"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,8,8,0"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Page>