<Application x:Class="Cleaner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- === Палитра === -->
            <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5" />
            <SolidColorBrush x:Key="TextMutedBrush"     Color="#8A8A8A" />

            <SolidColorBrush x:Key="AccentBrush"        Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentPurpleBrush"  Color="#8B5CF6" />
            <SolidColorBrush x:Key="AccentGlowBrush"    Color="#8060CDFF" />

            <SolidColorBrush x:Key="CardBgBrush"        Color="#1B1B1B" />
            <SolidColorBrush x:Key="CardBorderBrush"    Color="#2A2A2A" />
            <SolidColorBrush x:Key="CardHoverBgBrush"   Color="#232323" />
            <SolidColorBrush x:Key="RowHoverBrush"      Color="#14FFFFFF" />

            <SolidColorBrush x:Key="SafeBrush"          Color="#2ECC71" />
            <SolidColorBrush x:Key="CautionBrush"       Color="#E5A000" />
            <SolidColorBrush x:Key="DangerBrush"        Color="#E74C3C" />
            <SolidColorBrush x:Key="InfoBrush"          Color="#60CDFF" />

            <!-- === Градиенты === -->
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#60CDFF" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PageHeaderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2E60CDFF" Offset="0" />
                <GradientStop Color="#188B5CF6" Offset="0.55" />
                <GradientStop Color="#00FFFFFF"  Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="TopStripeBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0060CDFF" Offset="0" />
                <GradientStop Color="#6060CDFF" Offset="0.2" />
                <GradientStop Color="#608B5CF6" Offset="0.5" />
                <GradientStop Color="#6060CDFF" Offset="0.8" />
                <GradientStop Color="#0060CDFF" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CategoryIconBgBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#33FFFFFF" Offset="0" />
                <GradientStop Color="#11FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <!-- === Базовые стили === -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style TargetType="ScrollViewer">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>

            <!-- === Чип пресета === -->
            <Style x:Key="PresetChipStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    CornerRadius="12"
                                    Padding="18,10"
                                    Background="#2D2D2D"
                                    BorderBrush="#3D3D3D"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4A4A"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- === КАРТОЧКА КАТЕГОРИИ (Border вокруг CardExpander) === -->
            <Style x:Key="CategoryCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="4" />
            </Style>

            <!-- === Кружок-бейдж уровня === -->
            <Style x:Key="LevelBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,3,10,0" />
                <Setter Property="Background" Value="#3A3A3A" />
            </Style>

            <!-- === Круглая иконка категории === -->
            <Style x:Key="CategoryIconStyle" TargetType="Border">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{StaticResource CategoryIconBgBrush}" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>

            <!-- === Строка операции/твика (hover-подсветка) === -->
            <Style x:Key="RowBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>