<ui:FluentWindow x:Class="Cleaner.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Cleaner"
                 Height="760" Width="1180"
                 MinHeight="560" MinWidth="900"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Foreground="#FFFFFF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Cleaner"
                     Icon="{ui:SymbolIcon Sparkle24}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView x:Name="RootNavigation"
                               Grid.Column="0"
                               Width="230"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               OpenPaneLength="230"
                               IsPaneOpen="True">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Очистка"     Tag="cleanup"  Icon="{ui:SymbolIcon Broom24}" />
                    <ui:NavigationViewItem Content="Оптимизация" Tag="optimize" Icon="{ui:SymbolIcon Rocket24}" />
                    <ui:NavigationViewItem Content="Система"     Tag="system"   Icon="{ui:SymbolIcon Desktop24}" />
                    <ui:NavigationViewItem Content="Приватность" Tag="privacy"  Icon="{ui:SymbolIcon LockClosed24}" />
                    <ui:NavigationViewItem Content="Диск"        Tag="disk"     Icon="{ui:SymbolIcon HardDrive24}" />
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <Frame x:Name="RootFrame"
                   Grid.Column="1"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Grid>
    </Grid>
</ui:FluentWindow>