<ui:FluentWindow x:Class="Cleaner.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" xmlns:app="clr-namespace:Cleaner.App" xmlns:views="clr-namespace:Cleaner.App.Views" Title="Cleaner" Height="860" Width="1360" MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" Background="{DynamicResource BgBaseBrush}" FontFamily="{StaticResource FontUi}" Foreground="{DynamicResource TextPrimaryBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource BgBaseBrush}">
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:TitleBar x:Name="AppTitleBar" Height="34" MinHeight="34" ApplicationTheme="Dark" Title="{x:Static app:MainWindow.ApplicationTitle}" Icon="{ui:SymbolIcon Sparkle24}" Foreground="{DynamicResource TextPrimaryBrush}" ButtonsForeground="{DynamicResource TextPrimaryBrush}" ButtonsBackground="{DynamicResource BgHoverBrush}"/>
        <Border x:Name="StatusBarHost" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,154,0" Background="Transparent" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CpuText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="{Binding RamText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="{Binding DiskText}" Margin="16,0,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,1">
            <DockPanel Margin="10,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <ui:Button x:Name="HistoryButton" Content="{loc:Loc history.title}" Icon="{ui:SymbolIcon History24}" Click="OnHistoryClick" Appearance="Transparent" FontSize="12" Padding="8,7" ToolTip="{loc:Loc history.title}" AutomationProperties.Name="{loc:Loc history.title}"/>
                    <ui:Button x:Name="WhatsNewButton" Content="{loc:Loc news.title}" Icon="{ui:SymbolIcon Sparkle24}" Click="OnWhatsNewClick" Appearance="Transparent" FontSize="12" Padding="8,7" ToolTip="{loc:Loc news.title}" AutomationProperties.Name="{loc:Loc news.title}"/>
                    <Border Width="1" Height="22" Background="{DynamicResource BorderSubtleBrush}" Margin="6,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Search24}" Click="OnOpenPaletteClick" Appearance="Transparent" Width="34" Height="34" Padding="7" ToolTip="{loc:Loc design.commands}" AutomationProperties.Name="{loc:Loc design.commands}"/>
                    <ui:Button x:Name="SettingsButton" Icon="{ui:SymbolIcon Settings24}" Click="OnSettingsClick" Appearance="Transparent" Width="34" Height="34" Padding="7" ToolTip="{loc:Loc settings.title}" AutomationProperties.Name="{loc:Loc settings.title}"/>
                </StackPanel>
                <ListBox x:Name="RootNavigation" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource NavItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Contained">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBoxItem Tag="cleanup" AutomationProperties.Name="{loc:Loc t.ochistka}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Broom24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="{loc:Loc t.ochistka}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></ListBoxItem>
                        <ListBoxItem Tag="optimize" AutomationProperties.Name="{loc:Loc t.optimizaciya}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Rocket24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="{loc:Loc t.optimizaciya}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></ListBoxItem>
                        <ListBoxItem Tag="startup" AutomationProperties.Name="{loc:Loc design.startup.nav}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="{loc:Loc design.startup.nav}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></ListBoxItem>
                        <ListBoxItem Tag="system" AutomationProperties.Name="{loc:Loc t.sistema}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Desktop24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="{loc:Loc t.sistema}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></ListBoxItem>
                        <ListBoxItem Tag="privacy" AutomationProperties.Name="{loc:Loc design.recovery}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="{loc:Loc design.recovery}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></ListBoxItem>
                        <ListBoxItem Tag="disk" AutomationProperties.Name="{loc:Loc t.disk}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Storage24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="{loc:Loc t.disk}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid x:Name="WorkspaceHost" Grid.Row="2"><Frame x:Name="RootFrame" NavigationUIVisibility="Hidden" Background="{DynamicResource BgBaseBrush}"/></Grid>
        <!-- Snackbar показывается поверх всего окна, снизу справа -->
        <ui:SnackbarPresenter x:Name="RootSnackbar" Grid.Row="0" Grid.RowSpan="3" />
        <!-- Командная палитра (Ctrl+K) -->
        <Grid x:Name="PaletteOverlay" Grid.RowSpan="3" Panel.ZIndex="90" Visibility="Collapsed" Background="#80000000" MouseLeftButtonDown="OnPaletteBackdropClick">
            <Border Width="560" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0" Background="{DynamicResource BgOverlayBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" Effect="{StaticResource ShadowLg}" MouseLeftButtonDown="OnPaletteCardClick">
                <StackPanel>
                    <ui:TextBox x:Name="PaletteInput" Margin="12,12,12,8" PlaceholderText="{loc:Loc ui.palette.placeholder}" TextChanged="OnPaletteTextChanged" PreviewKeyDown="OnPaletteKeyDown" />
                    <ListBox x:Name="PaletteList" MaxHeight="320" Margin="8,0,8,12" Background="Transparent" BorderThickness="0" DisplayMemberPath="Title" PreviewMouseLeftButtonUp="OnPaletteItemClick" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="SafetyOverlay" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="95" Visibility="Collapsed" Background="#B310141C" KeyboardNavigation.TabNavigation="Cycle">
            <views:FirstRunSafetyView x:Name="SafetyNotice" Margin="24"/>
        </Grid>
        <!-- Диалог подтверждения внутри окна -->
        <Grid x:Name="DialogOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed" Background="#99000000" PreviewKeyDown="OnDialogKeyDown">
            <Border MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Padding="24" Background="{DynamicResource BgOverlayBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" Effect="{StaticResource ShadowLg}">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="320" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DialogMessage" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <ui:Button x:Name="DialogCancel" MinWidth="96" Margin="0,0,8,0" Click="OnDialogCancel" />
                        <ui:Button x:Name="DialogConfirm" MinWidth="96" Appearance="Primary" Style="{StaticResource PrimaryButtonStyle}" Click="OnDialogConfirm" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
