<ui:FluentWindow x:Class="Cleaner.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:Cleaner.App.Localization" Title="Cleaner" Height="860" Width="1360" MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round" Background="{DynamicResource BgBaseBrush}" FontFamily="{StaticResource FontUi}" Foreground="{StaticResource TextPrimaryBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar ApplicationTheme="Dark" Title="Cleaner" Icon="{ui:SymbolIcon Sparkle24}" Foreground="{StaticResource TextPrimaryBrush}" ButtonsForeground="{StaticResource TextPrimaryBrush}" ButtonsBackground="{StaticResource BgHoverBrush}" />
        <Border Grid.Row="1" Background="{StaticResource BorderSubtleBrush}" />
        <Border x:Name="StatusBarHost" Grid.Row="2" Padding="24,8" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="{loc:Loc design.workspace}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Canvas Width="64" Height="16">
                        <Polyline Points="{Binding CpuPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                    </Canvas>
                    <TextBlock Text="{Binding CpuText}" Margin="8,0,24,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Canvas Width="64" Height="16">
                        <Polyline Points="{Binding RamPoints}" Stroke="{StaticResource SafeBrush}" StrokeThickness="1.5" />
                    </Canvas>
                    <TextBlock Text="{Binding RamText}" Margin="8,0,24,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DiskText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14,24,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,0,0,28">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Sparkle24" Foreground="{DynamicResource AccentBrush}" FontSize="26" />
                            <TextBlock Text="Cleaner" FontSize="23" FontWeight="SemiBold" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc design.tagline}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{loc:Loc design.tools}" Style="{StaticResource SectionLabelStyle}" Margin="12,0,0,12" />
                    <ListBox x:Name="RootNavigation" Grid.Row="2" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                        <ListBoxItem Tag="cleanup">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Broom24" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Loc t.ochistka}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="optimize">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Rocket24" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Loc t.optimizaciya}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="startup">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Loc design.startup.nav}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="system">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Loc t.sistema}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="privacy">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Loc design.recovery}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="disk">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Storage24" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Loc t.disk}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                    <StackPanel Grid.Row="3">
                        <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="{loc:Loc design.commands}" Icon="{ui:SymbolIcon Search24}" Click="OnOpenPaletteClick" Appearance="Transparent" HorizontalAlignment="Stretch" Padding="8" />
                            <ui:Button x:Name="SettingsButton" Grid.Column="1" Icon="{ui:SymbolIcon Settings24}" Click="OnSettingsClick" Appearance="Transparent" Width="40" Height="40" Padding="8" Margin="4,0,0,0" ToolTip="{loc:Loc settings.title}" AutomationProperties.Name="{loc:Loc settings.title}" />
                        </Grid>
                        <TextBlock Text="Ctrl + K" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="14,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Frame x:Name="RootFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Background="{DynamicResource BgBaseBrush}" />
        </Grid>
        <!-- Snackbar показывается поверх всего окна, снизу справа -->
        <ui:SnackbarPresenter x:Name="RootSnackbar" Grid.Row="0" Grid.RowSpan="4" />
        <!-- Командная палитра (Ctrl+K) -->
        <Grid x:Name="PaletteOverlay" Grid.RowSpan="4" Panel.ZIndex="90" Visibility="Collapsed" Background="#80000000" MouseLeftButtonDown="OnPaletteBackdropClick">
            <Border Width="560" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0" Background="{StaticResource BgOverlayBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" Effect="{StaticResource ShadowLg}" MouseLeftButtonDown="OnPaletteCardClick">
                <StackPanel>
                    <ui:TextBox x:Name="PaletteInput" Margin="12,12,12,8" PlaceholderText="{loc:Loc ui.palette.placeholder}" TextChanged="OnPaletteTextChanged" PreviewKeyDown="OnPaletteKeyDown" />
                    <ListBox x:Name="PaletteList" MaxHeight="320" Margin="8,0,8,12" Background="Transparent" BorderThickness="0" DisplayMemberPath="Title" PreviewMouseLeftButtonUp="OnPaletteItemClick" />
                </StackPanel>
            </Border>
        </Grid>
        <!-- Диалог подтверждения внутри окна -->
        <Grid x:Name="DialogOverlay" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="Collapsed" Background="#99000000" PreviewKeyDown="OnDialogKeyDown">
            <Border MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Padding="24" Background="{StaticResource BgOverlayBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" Effect="{StaticResource ShadowLg}">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="320" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DialogMessage" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource TextSecondaryBrush}" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <ui:Button x:Name="DialogCancel" MinWidth="96" Margin="0,0,8,0" Click="OnDialogCancel" />
                        <ui:Button x:Name="DialogConfirm" MinWidth="96" Appearance="Primary" Style="{StaticResource PrimaryButtonStyle}" Click="OnDialogConfirm" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
